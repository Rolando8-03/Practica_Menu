<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680.0"
            prefWidth="1000.0"
            stylesheets="@inventario.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.practica_menu.InventarioController">

    <top>

        <VBox>

            <MenuBar>

                <menus>

                    <Menu text="Archivo">

                        <items>

                            <MenuItem fx:id="nuevoMenuItem"
                                      text="Nuevo"
                                      onAction="#nuevoProducto"/>

                            <MenuItem text="Limpiar"
                                      onAction="#limpiarCampos"/>

                            <SeparatorMenuItem/>

                            <MenuItem fx:id="salirMenuItem"
                                      text="Salir"
                                      onAction="#salirAplicacion"/>

                        </items>

                    </Menu>

                    <Menu text="Producto">

                        <items>

                            <MenuItem fx:id="guardarMenuItem"
                                      text="Guardar"
                                      onAction="#guardarProducto"/>

                            <MenuItem text="Editar"
                                      onAction="#editarProducto"/>

                            <MenuItem text="Eliminar"
                                      onAction="#eliminarProducto"/>

                        </items>

                    </Menu>

                    <Menu text="Ayuda">

                        <items>

                            <MenuItem text="Acerca de"
                                      onAction="#mostrarAcercaDe"/>

                        </items>

                    </Menu>

                </menus>

            </MenuBar>

            <ToolBar styleClass="barra-herramientas">

                <items>

                    <Button text="Nuevo"
                            onAction="#nuevoProducto"
                            styleClass="boton-herramienta"/>

                    <Button text="Guardar"
                            onAction="#guardarProducto"
                            styleClass="boton-principal"/>

                    <Button text="Editar"
                            onAction="#editarProducto"
                            styleClass="boton-herramienta"/>

                    <Button text="Eliminar"
                            onAction="#eliminarProducto"
                            styleClass="boton-peligro"/>

                </items>

            </ToolBar>

        </VBox>

    </top>

    <center>

        <VBox spacing="16.0"
              styleClass="contenido">

            <padding>

                <Insets top="20.0"
                        right="24.0"
                        bottom="18.0"
                        left="24.0"/>

            </padding>

            <VBox spacing="4.0">

                <Label text="Control de inventario"
                       styleClass="titulo"/>

                <Label text="Distribuidora El Güegüense"
                       styleClass="subtitulo"/>

            </VBox>

            <GridPane hgap="14.0"
                      vgap="10.0"
                      styleClass="tarjeta-formulario">

                <padding>

                    <Insets top="16.0"
                            right="18.0"
                            bottom="18.0"
                            left="18.0"/>

                </padding>

                <columnConstraints>

                    <ColumnConstraints minWidth="95.0"/>

                    <ColumnConstraints hgrow="ALWAYS"/>

                    <ColumnConstraints minWidth="95.0"/>

                    <ColumnConstraints hgrow="ALWAYS"/>

                </columnConstraints>

                <Label text="Código:"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"
                       styleClass="etiqueta-campo"/>

                <TextField fx:id="codigoTextField"
                           promptText="Ej. P006"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Nombre:"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="2"
                       styleClass="etiqueta-campo"/>

                <TextField fx:id="nombreTextField"
                           promptText="Nombre del producto"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="3"/>

                <Label text="Categoría:"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"
                       styleClass="etiqueta-campo"/>

                <TextField fx:id="categoriaTextField"
                           promptText="Categoría"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                <Label text="Precio (C$):"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="2"
                       styleClass="etiqueta-campo"/>

                <TextField fx:id="precioTextField"
                           promptText="Ej. 150.50"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="3"/>

                <Label text="Existencia:"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"
                       styleClass="etiqueta-campo"/>

                <TextField fx:id="existenciaTextField"
                           promptText="Ej. 25"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

                <HBox spacing="10.0"
                      alignment="CENTER_RIGHT"
                      GridPane.rowIndex="2"
                      GridPane.columnIndex="2"
                      GridPane.columnSpan="2">

                    <Button text="Limpiar"
                            onAction="#limpiarCampos"
                            styleClass="boton-secundario"/>

                    <Button text="Guardar producto"
                            onAction="#guardarProducto"
                            styleClass="boton-guardar"/>

                </HBox>

            </GridPane>

            <Label text="Productos registrados"
                   styleClass="encabezado-tabla"/>

            <TableView fx:id="productosTableView"
                       VBox.vgrow="ALWAYS">

                <placeholder>

                    <Label text="No hay productos registrados."/>

                </placeholder>

                <columns>

                    <TableColumn fx:id="codigoTableColumn"
                                 text="Código"
                                 prefWidth="115.0"/>

                    <TableColumn fx:id="nombreTableColumn"
                                 text="Nombre"
                                 prefWidth="280.0"/>

                    <TableColumn fx:id="categoriaTableColumn"
                                 text="Categoría"
                                 prefWidth="190.0"/>

                    <TableColumn fx:id="precioTableColumn"
                                 text="Precio (C$)"
                                 prefWidth="150.0"/>

                    <TableColumn fx:id="existenciaTableColumn"
                                 text="Existencia"
                                 prefWidth="130.0"/>

                </columns>

                <contextMenu>

                    <ContextMenu>

                        <items>

                            <MenuItem text="Editar producto"
                                      onAction="#editarProducto"/>

                            <MenuItem text="Eliminar producto"
                                      onAction="#eliminarProducto"/>

                            <SeparatorMenuItem/>

                            <MenuItem text="Ver detalle"
                                      onAction="#verDetalleProducto"/>

                        </items>

                    </ContextMenu>

                </contextMenu>

            </TableView>

            <HBox alignment="CENTER_LEFT"
                  spacing="8.0"
                  styleClass="barra-estado">

                <Label text="●"
                       styleClass="indicador-estado"/>

                <Label fx:id="estadoLabel"
                       text="Aplicación lista."/>

            </HBox>

        </VBox>

    </center>

</BorderPane>